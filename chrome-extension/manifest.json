{
    "manifest_version": 3,
    "name": "TubeMind",
    "version": "1.0.0",
    "permissions": [
        "tabs",
        "scripting",
        "activeTab"
    ],
    "host_permissions": [
        "https://www.youtube.com/*"
    ],
    "description": "AI assistant for YouTube videos.",
    "action": {
        "default_popup": "popup/popup.html"
    }
}